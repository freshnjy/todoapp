# 할 일 앱 systemd 유닛 예시.
# 서버에서는 /etc/systemd/system/todoapp.service 로 복사해 쓴다 (docs/deploy.md 4번).
# 경로와 사용자는 이 서버 기준이다. 다르면 아래 값을 바꾼다. 비밀 값은 여기에 적지 않는다.

[Unit]
Description=Todo App (FastAPI, 127.0.0.1:8003)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/todoapp

# 환경 변수는 .env에서 읽는다. 읽는 규칙이 python-dotenv와 조금 다르다:
# 줄 끝에 주석을 붙이지 않는다 (값에 들어간다). 주석은 줄 맨 앞에 쓴다. 값에는 따옴표가 필요 없다.
EnvironmentFile=/home/ubuntu/todoapp/.env

# 127.0.0.1에만 연다. 바깥에서는 nginx(/todo/)를 통해서만 들어온다.
# --proxy-headers: nginx가 넘기는 X-Forwarded-Proto를 믿고 https로 인식한다.
# --forwarded-allow-ips 127.0.0.1: 같은 서버의 nginx가 보낸 헤더만 믿는다.
# 워커는 1개로 둔다 (--workers를 넣지 않는다). 로그인 실패 제한이 프로세스 메모리에 있다.
ExecStart=/home/ubuntu/todoapp/venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8003 --proxy-headers --forwarded-allow-ips 127.0.0.1

Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
