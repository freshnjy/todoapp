# 실제 값은 .env에만 적고 절대 커밋하지 않는다.
# systemd가 읽으므로: 줄 끝에 주석을 붙이지 않는다 (값에 들어간다). 값에 따옴표를 쓰지 않는다.

# --- 자체 로그인 ---
# 로그인 비밀번호. 직접 정한다.
TODO_PASSWORD=
# 쿠키 서명에 쓰는 임의의 긴 문자열. 아래 명령으로 만든다. 바꾸면 모든 기기가 다시 로그인해야 한다.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
TODO_SESSION_SECRET=
# 기기 쿠키 유지 기간(일)
TODO_SESSION_DAYS=30
# 쿠키 경로와 Secure. 서버에서는 아래 값 그대로 둔다.
# 로컬(http://localhost:8003)에서는 두 줄을 아래처럼 바꿔야 로그인이 된다.
#   TODO_COOKIE_PATH=/
#   TODO_COOKIE_SECURE=false
TODO_COOKIE_PATH=/todo/
TODO_COOKIE_SECURE=true

# --- 저장소 ---
# SQLite 파일(todo.sqlite3)을 둘 폴더. 로컬에서는 ./data
TODO_DATA_DIR=/home/ubuntu/todoapp/data
